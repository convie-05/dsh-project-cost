{
  "name": "dsh-project-cost",
  "version": "1.0.1",
  "description": "Per-project token spend for DeepSeek Harness: attribute cumulative/today token usage and real billed cost to each session working directory, with an expandable settings panel and a read-only agent tool.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token",
    "usage",
    "cost",
    "billing",
    "project",
    "observability"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/convie-05/dsh-project-cost.git"
  },
  "bugs": {
    "url": "https://github.com/convie-05/dsh-project-cost/issues"
  },
  "homepage": "https://github.com/convie-05/dsh-project-cost#readme"
}
